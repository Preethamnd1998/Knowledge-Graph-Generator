####################################################################
# Knowledge Graph MCP Server — Configuration
#
# Copy to mcp-config.env for local reference, or (more commonly) set
# these as the "env" block in your MCP client config (Claude Code /
# Claude Desktop) — see MCP.md "Claude Code configuration". The server
# reads these from the process environment; there is nothing to
# comment/uncomment like kg-config.env, just plain KEY=VALUE.
####################################################################

# Path to the knowledge_graph.db produced by `python indexer.py`.
# Relative paths resolve against the repo root. Requires SINGLE_DATABASE=true
# in kg-config.env — dependency/caller traversal spans service boundaries,
# which per-service .db files can't represent.
KG_DB_PATH=./output/knowledge_graph.db

# Name the server advertises to MCP clients.
MCP_SERVER_NAME=knowledge-graph

# DEBUG | INFO | WARNING | ERROR
MCP_LOG_LEVEL=INFO

# Default/ceiling for how many results any tool returns. A caller may
# request fewer; requests for more are silently capped here.
MCP_MAX_RESULTS=10

# Ceiling for traversal depth (get_service_dependencies, find_callers,
# find_dependencies). Default depth when a caller doesn't specify one is
# always 1, regardless of this ceiling.
MCP_MAX_DEPTH=3

# Soft token budget get_context_pack trims itself to fit, when a caller
# doesn't pass its own max_tokens.
MCP_MAX_CONTEXT_TOKENS=3000

# Per-query SQLite timeout (seconds) — a query running longer than this
# is aborted and returned to the caller as a query_timeout error.
MCP_QUERY_TIMEOUT_SECONDS=5
