####################################################################
# Knowledge Graph Indexer — Configuration
#
# HOW TO USE (no technical knowledge required):
#   - Lines starting with "#" are DISABLED (ignored).
#   - Remove the leading "#" from a service/subproject line to INCLUDE it.
#   - Add a leading "#" to a service/subproject line to EXCLUDE it.
#   - Save the file, then run:  python indexer.py
#
# Do not rename the KEY names on the left of "=". Only change values,
# and comment/uncomment lines inside the *_START / *_END blocks below.
####################################################################

# Absolute path to the folder that contains all backend microservices
# (each one is a sub-folder with its own pom.xml / src).
ROOT_PATH=D:\GitLab-Workspace\UI-BE

# --------------------------------------------------------------
# BACKEND_SERVICES — Java microservices under ROOT_PATH.
# Uncommented (no leading #) = indexed. Commented (#) = skipped.
# --------------------------------------------------------------
BACKEND_SERVICES_START
appointment-service
auth-service
clinical-common-service
config-service
core-service
gateway-service
inventory-service
ipd-clinical-service
ipd-service
notification-service
rcm-service
report-service
supplementary-service
user-management-service
file-store
BACKEND_SERVICES_END

# --------------------------------------------------------------
# Angular monorepo (contains the Angular sub-projects below).
# Path is resolved as ROOT_PATH\ANGULAR_PROJECT
# --------------------------------------------------------------
ANGULAR_PROJECT=lifetrenz-core

# --------------------------------------------------------------
# ANGULAR_SUBPROJECTS — folders under
# ROOT_PATH\ANGULAR_PROJECT\projects
# Uncommented (no leading #) = indexed. Commented (#) = skipped.
#
# ROOT_APP is a special entry (not a real folder under projects/) that
# indexes ANGULAR_PROJECT's own main app shell — its root src/ folder
# (main.ts, the root app module/components, etc.) — which otherwise
# never gets indexed since it lives outside projects/. Leave the text
# exactly as "ROOT_APP"; comment/uncomment it like any other line.
# --------------------------------------------------------------
ANGULAR_SUBPROJECTS_START
ROOT_APP
adt
ambulance
anesthesia
blood-bank
clinical-casesheet
clinical-pharmacy
committee
daycare-clinical
diet-management
doctor-payout
emergency
front-desk-management
haemodialysis
house-keeping
incident-management
indent
infection
inpatient
inventory
jasper-report-template
lab-sample-collection
lis-configuration
lis-sample-tracking
masters
mis-reports
mortuary
opd-clinical
operation-theatre
ot-lib
patient-lib
pharmacy
physiotherapy
pre-surgery
procurement
queue-management
revenue-cycle-management
ris
settings
support-ticket-management
user-management
workflow
ANGULAR_SUBPROJECTS_END

# --------------------------------------------------------------
# REACT_PROJECT_PATH — absolute path to a React app (optional).
# Leave blank to skip React indexing entirely (no React project
# was found in this workspace as of writing this config).
# --------------------------------------------------------------
REACT_PROJECT_PATH=

# --------------------------------------------------------------
# INDEX_MODE — one of: all | backend_only | frontend_only | selective
#   all            -> index backend + angular + react (per lists above)
#   backend_only   -> index BACKEND_SERVICES only
#   frontend_only  -> index Angular + React only
#   selective      -> same as "all", but silently skips any category
#                      that has zero uncommented entries (no warning)
# --------------------------------------------------------------
INDEX_MODE=selective

# Folder where the generated .db file(s) will be written.
# Created automatically if it does not exist.
OUTPUT_DIR=D:\GitLab-Workspace\Knowledge Repo\Knwoledge graphs

# true  -> one combined knowledge_graph.db with everything
# false -> one .db file per service / subproject
SINGLE_DATABASE=true
