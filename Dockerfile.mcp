FROM python:3.11-slim

WORKDIR /app

COPY requirements-mcp.txt .
RUN pip install --no-cache-dir -r requirements-mcp.txt

COPY mcp_server/ ./mcp_server/

ENV KG_DB_PATH=/app/output/knowledge_graph.db

# stdio transport writes JSON-RPC to stdout — nothing else may write there.
# `docker compose run --rm -T knowledge-graph-mcp` (or `docker run -i`)
# is how an MCP client actually talks to this container; see MCP.md.
ENTRYPOINT ["python", "-m", "mcp_server.server"]
